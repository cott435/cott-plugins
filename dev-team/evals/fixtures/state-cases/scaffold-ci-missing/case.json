{
  "note": "the workspace exists and no CI workflow: the scaffold step writes it",
  "steps": [
    {
      "do": "base"
    },
    {
      "files": {
        "pyproject.toml": "[project]\nname = \"repo\"\nversion = \"0.0.0\"\n\n[tool.uv.workspace]\nmembers = [\"packages/*\"]\n",
        "packages/data/pyproject.toml": "[project]\nname = \"data\"\nversion = \"0.0.0\"\n"
      },
      "message": "data: scaffold"
    }
  ],
  "args": [
    "--scaffold",
    "data"
  ],
  "expect": {
    "exit": 1,
    "contains": [
      "scaffold: needed (no .github/workflows/ci.yml)"
    ]
  }
}
