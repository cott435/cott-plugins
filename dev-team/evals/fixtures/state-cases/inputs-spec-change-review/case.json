{
  "note": "after a spec-change round and the redesign it asked for, the implementer's Review: carries that round's reports",
  "steps": [
    {
      "do": "base"
    },
    {
      "do": "design",
      "section": "ingest"
    },
    {
      "do": "tests",
      "section": "ingest"
    },
    {
      "do": "build",
      "section": "ingest"
    },
    {
      "do": "review",
      "section": "ingest",
      "round": 1,
      "reports": {
        "a": "approve",
        "b": "spec-change"
      },
      "spec": {
        "b": "design: §5 names one entry point; the probe doc shows two — docs/sources/trades.md, Observed schema"
      },
      "layout": "old"
    },
    {
      "do": "edit",
      "path": "docs/packages/data/design/ingest.md",
      "append": "\n- a second entry point\n",
      "message": "data/ingest: design answers r1-b"
    },
    {
      "do": "edit",
      "path": "packages/data/tests/intent/ingest/test_ingest.py",
      "append": "\n# regenerated\n",
      "message": "data/ingest: intent tests for r1-b"
    }
  ],
  "args": [
    "--inputs",
    "data/ingest"
  ],
  "expect": {
    "exit": 0,
    "contains": [
      "Review: docs/reviews/"
    ],
    "absent": [
      "Review: none"
    ]
  }
}
